+#ifndef __CPU_O3_ROB_RESIZER_HH__
+#define __CPU_O3_ROB_RESIZER_HH__
+
+#include <cstdint>
+
+#include "base/statistics.hh"
+#include "params/RobResizer.hh"
+#include "sim/sim_object.hh"
+
+namespace gem5
+{
+
+namespace o3
+{
+
+class CPU;
+
+/**
+ * two-state fsm that caps the rob (and, proportionally, the iq and lsq)
+ * when the committed branch mispredict rate is high, and restores full
+ * capacity once prediction is accurate again.
+ *
+ * shrinking only lowers the allocation cap. entries already above the
+ * cap are not squashed; they drain through commit as normal.
+ */
+class RobResizer : public SimObject
+{
+  public:
+    enum State
+    {
+        Full,
+        Restricted
+    };
+
+    RobResizer(const RobResizerParams &params);
+
+    /** called once by the cpu constructor. */
+    void setCPU(CPU *cpu);
+
+    /** called by commit for every committed macro instruction. */
+    void notifyCommit(bool is_control);
+
+    /** called by commit when a branch mispredict squash is handled. */
+    void notifyMispredict();
+
+    State state() const { return _state; }
+
+  private:
+    /** evaluates the finished window and resets its counters. */
+    void endWindow();
+
+    /** moves the fsm to next_state and applies the new cap. */
+    void transition(State next_state);
+
+    CPU *cpu;
+
+    State _state;
+
+    /** physical rob size, read from the cpu. */
+    unsigned fullEntries;
+    const unsigned restrictedEntries;
+
+    const uint64_t windowInsts;
+    const unsigned minWindowBranches;
+    const double shrinkRate;
+    const double growRate;
+    const unsigned shrinkWindows;
+    const unsigned growWindows;
+
+    // counters for the current sampling window
+    uint64_t winInsts;
+    uint64_t winBranches;
+    uint64_t winMispredicts;
+
+    // consecutive windows voting for a state change
+    unsigned voteStreak;
+
+    struct RobResizerStats : public statistics::Group
+    {
+        RobResizerStats(statistics::Group *parent);
+
+        statistics::Scalar windows;
+        statistics::Scalar quietWindows;
+        statistics::Scalar shrinks;
+        statistics::Scalar grows;
+        statistics::Scalar instsFull;
+        statistics::Scalar instsRestricted;
+        statistics::Scalar mispredicts;
+        statistics::Scalar branches;
+        statistics::Distribution windowMispredictRate;
+        statistics::Formula restrictedFraction;
+    } stats;
+};
+
+} // namespace o3
+} // namespace gem5
+
+#endif // __CPU_O3_ROB_RESIZER_HH__
