diff --git a/src/cpu/o3/RobResizer.py b/src/cpu/o3/RobResizer.py
new file mode 100644
index 0000000000..0995139001
--- /dev/null
+++ b/src/cpu/o3/RobResizer.py
@@ -0,0 +1,46 @@
+# dynamic rob resizing driven by committed branch mispredict rate.
+#
+# the fsm has two states: full (physical numROBEntries) and restricted
+# (restrictedROBEntries). iq and lsq are capped by the same fraction.
+#
+# design parameters that are still open (thresholds, window size,
+# hysteresis) have no default on purpose, so every experiment script
+# has to choose them explicitly.
+
+from m5.params import *
+from m5.SimObject import SimObject
+
+
+class RobResizer(SimObject):
+    type = "RobResizer"
+    cxx_class = "gem5::o3::RobResizer"
+    cxx_header = "cpu/o3/rob_resizer.hh"
+
+    restrictedROBEntries = Param.Unsigned(
+        64, "Active rob entries while in the restricted state"
+    )
+
+    windowInsts = Param.UInt64(
+        "Sampling window length, in committed instructions"
+    )
+    minWindowBranches = Param.Unsigned(
+        1,
+        "Windows with fewer committed branches than this do not vote "
+        "for a state change",
+    )
+
+    shrinkMispredictRate = Param.Float(
+        "Mispredicts per committed branch above which a window votes "
+        "to shrink"
+    )
+    growMispredictRate = Param.Float(
+        "Mispredicts per committed branch below which a window votes "
+        "to grow (must be <= shrinkMispredictRate)"
+    )
+
+    shrinkWindows = Param.Unsigned(
+        "Consecutive shrink votes needed to enter the restricted state"
+    )
+    growWindows = Param.Unsigned(
+        "Consecutive grow votes needed to return to the full state"
+    )
diff --git a/src/cpu/o3/rob_resizer.cc b/src/cpu/o3/rob_resizer.cc
new file mode 100644
index 0000000000..53ac0d1fdb
--- /dev/null
+++ b/src/cpu/o3/rob_resizer.cc
@@ -0,0 +1,162 @@
+#include "cpu/o3/rob_resizer.hh"
+
+#include "base/logging.hh"
+#include "base/trace.hh"
+#include "cpu/o3/cpu.hh"
+#include "debug/RobResizer.hh"
+
+namespace gem5
+{
+
+namespace o3
+{
+
+RobResizer::RobResizer(const RobResizerParams &params)
+    : SimObject(params),
+      cpu(nullptr),
+      _state(Full),
+      fullEntries(0),
+      restrictedEntries(params.restrictedROBEntries),
+      windowInsts(params.windowInsts),
+      minWindowBranches(params.minWindowBranches),
+      shrinkRate(params.shrinkMispredictRate),
+      growRate(params.growMispredictRate),
+      shrinkWindows(params.shrinkWindows),
+      growWindows(params.growWindows),
+      winInsts(0),
+      winBranches(0),
+      winMispredicts(0),
+      voteStreak(0),
+      stats(this)
+{
+    fatal_if(windowInsts == 0, "%s: windowInsts must be > 0", name());
+    fatal_if(restrictedEntries == 0,
+             "%s: restrictedROBEntries must be > 0", name());
+    fatal_if(shrinkRate < 0.0 || shrinkRate > 1.0 ||
+             growRate < 0.0 || growRate > 1.0,
+             "%s: mispredict rates must be in [0, 1]", name());
+    // grow threshold at or below shrink threshold gives the hysteresis band
+    fatal_if(growRate > shrinkRate,
+             "%s: growMispredictRate (%f) must be <= shrinkMispredictRate "
+             "(%f)", name(), growRate, shrinkRate);
+    fatal_if(shrinkWindows == 0 || growWindows == 0,
+             "%s: shrinkWindows and growWindows must be > 0", name());
+}
+
+void
+RobResizer::setCPU(CPU *_cpu)
+{
+    cpu = _cpu;
+    fullEntries = cpu->numROBEntries();
+    fatal_if(restrictedEntries > fullEntries,
+             "%s: restrictedROBEntries (%u) exceeds numROBEntries (%u)",
+             name(), restrictedEntries, fullEntries);
+}
+
+void
+RobResizer::notifyCommit(bool is_control)
+{
+    ++winInsts;
+    if (is_control) {
+        ++winBranches;
+        ++stats.branches;
+    }
+
+    if (_state == Full)
+        ++stats.instsFull;
+    else
+        ++stats.instsRestricted;
+
+    if (winInsts >= windowInsts)
+        endWindow();
+}
+
+void
+RobResizer::notifyMispredict()
+{
+    ++winMispredicts;
+    ++stats.mispredicts;
+}
+
+void
+RobResizer::endWindow()
+{
+    ++stats.windows;
+
+    if (winBranches < minWindowBranches) {
+        // too few branches to judge accuracy, hold the current state
+        ++stats.quietWindows;
+    } else {
+        double rate = double(winMispredicts) / double(winBranches);
+        stats.windowMispredictRate.sample(rate);
+
+        // a window votes for leaving the current state; any window that
+        // does not vote resets the streak
+        bool vote = (_state == Full) ? rate > shrinkRate : rate < growRate;
+        voteStreak = vote ? voteStreak + 1 : 0;
+
+        DPRINTF(RobResizer, "window: %llu branches, %llu mispredicts, "
+                "rate %.4f, state %s, streak %u\n",
+                winBranches, winMispredicts, rate,
+                _state == Full ? "full" : "restricted", voteStreak);
+
+        if (_state == Full && voteStreak >= shrinkWindows)
+            transition(Restricted);
+        else if (_state == Restricted && voteStreak >= growWindows)
+            transition(Full);
+    }
+
+    winInsts = 0;
+    winBranches = 0;
+    winMispredicts = 0;
+}
+
+void
+RobResizer::transition(State next_state)
+{
+    assert(cpu);
+    _state = next_state;
+    voteStreak = 0;
+
+    unsigned limit;
+    if (next_state == Restricted) {
+        ++stats.shrinks;
+        limit = restrictedEntries;
+    } else {
+        ++stats.grows;
+        limit = fullEntries;
+    }
+
+    DPRINTF(RobResizer, "rob limit -> %u\n", limit);
+    cpu->setWindowLimit(limit);
+}
+
+RobResizer::RobResizerStats::RobResizerStats(statistics::Group *parent)
+    : statistics::Group(parent),
+      ADD_STAT(windows, statistics::units::Count::get(),
+               "Sampling windows completed"),
+      ADD_STAT(quietWindows, statistics::units::Count::get(),
+               "Windows skipped for having too few branches"),
+      ADD_STAT(shrinks, statistics::units::Count::get(),
+               "Transitions from full to restricted"),
+      ADD_STAT(grows, statistics::units::Count::get(),
+               "Transitions from restricted to full"),
+      ADD_STAT(instsFull, statistics::units::Count::get(),
+               "Instructions committed in the full state"),
+      ADD_STAT(instsRestricted, statistics::units::Count::get(),
+               "Instructions committed in the restricted state"),
+      ADD_STAT(mispredicts, statistics::units::Count::get(),
+               "Branch mispredicts seen by the resizer"),
+      ADD_STAT(branches, statistics::units::Count::get(),
+               "Committed control instructions seen by the resizer"),
+      ADD_STAT(windowMispredictRate, statistics::units::Ratio::get(),
+               "Per-window mispredicts per committed branch"),
+      ADD_STAT(restrictedFraction, statistics::units::Ratio::get(),
+               "Fraction of committed instructions in the restricted state",
+               instsRestricted / (instsFull + instsRestricted))
+{
+    windowMispredictRate.init(0.0, 1.0, 0.05).flags(statistics::pdf);
+}
