+void
+CPU::setWindowLimit(unsigned rob_limit)
+{
+    const unsigned rob_size = rob.getNumEntries();
+    rob_limit = std::min(std::max(rob_limit, 1u), rob_size);
+
+    // iq and lsq keep the same fraction of their size as the rob
+    rob.setActiveLimit(rob_limit);
+    iew.instQueue.setActiveFraction(rob_limit, rob_size);
+    iew.ldstQueue.setActiveFraction(rob_limit, rob_size);
+
+    // make sure rename sees the new free counts even if the pipe is idle
+    commit.markROBLimitChanged();
+    iew.updateLSQNextCycle = true;
+}
